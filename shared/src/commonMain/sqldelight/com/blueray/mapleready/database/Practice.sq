CREATE TABLE PracticeQuestion (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    topicId TEXT NOT NULL,
    questionText TEXT NOT NULL
);

CREATE TABLE PracticeAnswer (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    questionId INTEGER NOT NULL,
    answerText TEXT NOT NULL,
    isCorrect INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY (questionId)
        REFERENCES PracticeQuestion(id)
        ON DELETE CASCADE
);

selectAllQuestions:
SELECT *
FROM PracticeQuestion;

selectQuestionById:
SELECT *
FROM PracticeQuestion
WHERE id = ?;

selectQuestionsByTopic:
SELECT *
FROM PracticeQuestion
WHERE topicId = ?;

selectAnswersForQuestion:
SELECT *
FROM PracticeAnswer
WHERE questionId = ?;


insertQuestion:
INSERT INTO PracticeQuestion(
    topicId,
    questionText
)
VALUES (?, ?);

insertAnswer:
INSERT INTO PracticeAnswer(
    questionId,
    answerText,
    isCorrect
)
VALUES (?, ?, ?);

countQuestions:
SELECT COUNT(*)
FROM PracticeQuestion;

deleteAllAnswers:
DELETE FROM PracticeAnswer;

deleteAllQuestions:
DELETE FROM PracticeQuestion;