CREATE TABLE PracticeQuestion (
    id INTEGER NOT NULL PRIMARY KEY,
    topicId TEXT NOT NULL
);

CREATE TABLE PracticeQuestionText (
    questionId INTEGER NOT NULL,
    languageCode TEXT NOT NULL,
    questionText TEXT NOT NULL,

    PRIMARY KEY (questionId, languageCode),

    FOREIGN KEY (questionId)
        REFERENCES PracticeQuestion(id)
        ON DELETE CASCADE
);

CREATE TABLE PracticeAnswer (
    id INTEGER NOT NULL PRIMARY KEY,
    questionId INTEGER NOT NULL,
    isCorrect INTEGER NOT NULL DEFAULT 0,

    FOREIGN KEY (questionId)
        REFERENCES PracticeQuestion(id)
        ON DELETE CASCADE
);

CREATE TABLE PracticeAnswerText (
    answerId INTEGER NOT NULL,
    languageCode TEXT NOT NULL,
    answerText TEXT NOT NULL,

    PRIMARY KEY (answerId, languageCode),

    FOREIGN KEY (answerId)
        REFERENCES PracticeAnswer(id)
        ON DELETE CASCADE
);

CREATE TABLE PracticeMetadata (
    key TEXT NOT NULL PRIMARY KEY,
    value TEXT NOT NULL
);



selectAllQuestionsByLanguage:
SELECT
    q.id,
    q.topicId,
    qt.questionText
FROM PracticeQuestion q
JOIN PracticeQuestionText qt
    ON qt.questionId = q.id
WHERE qt.languageCode = ?;

selectQuestionByIdAndLanguage:
SELECT
    q.id,
    q.topicId,
    qt.questionText
FROM PracticeQuestion q
JOIN PracticeQuestionText qt
    ON qt.questionId = q.id
WHERE q.id = ?
  AND qt.languageCode = ?;

selectQuestionsByTopicAndLanguage:
SELECT
    q.id,
    q.topicId,
    qt.questionText
FROM PracticeQuestion q
JOIN PracticeQuestionText qt
    ON qt.questionId = q.id
WHERE q.topicId = ?
  AND qt.languageCode = ?;

selectAnswersForQuestionAndLanguage:
SELECT
    a.id,
    a.questionId,
    a.isCorrect,
    at.answerText
FROM PracticeAnswer a
JOIN PracticeAnswerText at
    ON at.answerId = a.id
WHERE a.questionId = ?
  AND at.languageCode = ?;

getMetadataValue:
SELECT value
FROM PracticeMetadata
WHERE key = ?;

setMetadataValue:
INSERT OR REPLACE INTO PracticeMetadata(
    key,
    value
)
VALUES (?, ?);

insertQuestion:
INSERT INTO PracticeQuestion(
    id,
    topicId
)
VALUES (?, ?);

insertQuestionText:
INSERT INTO PracticeQuestionText(
    questionId,
    languageCode,
    questionText
)
VALUES (?, ?, ?);

insertAnswer:
INSERT INTO PracticeAnswer(
    id,
    questionId,
    isCorrect
)
VALUES (?, ?, ?);

insertAnswerText:
INSERT INTO PracticeAnswerText(
    answerId,
    languageCode,
    answerText
)
VALUES (?, ?, ?);


deleteAllAnswerTexts:
DELETE FROM PracticeAnswerText;

deleteAllAnswers:
DELETE FROM PracticeAnswer;

deleteAllQuestionTexts:
DELETE FROM PracticeQuestionText;

deleteAllQuestions:
DELETE FROM PracticeQuestion;
